{
  "manifest_version": 3,
  "name": "Zeta × JEV Feasibility Probe",
  "version": "0.2.0",
  "description": "Hide new Zeta replies while measuring a JEV intervention-decision round trip.",
  "permissions": ["storage", "downloads", "activeTab"],
  "host_permissions": [
    "https://zeta-ai.io/*",
    "https://api.typesafe.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Zeta × JEV feasibility",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://zeta-ai.io/ko/rooms/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
