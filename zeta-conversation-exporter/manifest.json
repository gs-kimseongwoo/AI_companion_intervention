{
  "manifest_version": 3,
  "name": "Zeta Conversation Exporter",
  "version": "0.7.3",
  "description": "Export the current Zeta conversation as JSON or Markdown.",
  "permissions": ["downloads", "activeTab", "storage", "webNavigation"],
  "host_permissions": ["https://zeta-ai.io/*", "https://frame.pingpong.ai/*"],
  "action": {
    "default_title": "Export Zeta conversation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://zeta-ai.io/ko/rooms/*", "https://frame.pingpong.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
